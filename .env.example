# Create a public, readable Sanity dataset and add its values here.
# Never expose a Sanity API token in a Vite environment variable.
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production

# Existing contact form values
VITE_EMAIL_SERVICE_ID=
VITE_EMAIL_PUBLIC_KEY=
VITE_EMAIL_TEMPLATE_ID=
